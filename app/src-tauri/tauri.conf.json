{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion Hub",
  "version": "0.1.0",
  "identifier": "com.companionhub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Companion Hub",
        "width": 1240,
        "height": 820,
        "minWidth": 940,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "backgroundColor": "#060708"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "Ettore Caputo",
    "copyright": "Copyright (c) 2026 Ettore Caputo",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/EttoreCaputo/companion-hub",
    "shortDescription": "Desktop hub for the DualEye and Yoru desk companions",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
